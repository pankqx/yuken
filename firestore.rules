rules_version = '2';

// Yuken Proof of Loading — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberDoc()) && get(memberDoc()).data.active == true; }
    function isAdmin() { return isMember() && get(memberDoc()).data.role == 'admin'; }
    function myProfile() { return get(memberDoc()).data.profileId; }

    // First-time setup: only while meta/setup does not exist, and only for
    // the account that is writing itself in as the admin in the same batch.
    function settingUp() {
      return signedIn()
        && !exists(/databases/$(database)/documents/meta/setup)
        && getAfter(/databases/$(database)/documents/meta/setup).data.adminUid == request.auth.uid;
    }

    match /meta/setup {
      allow get: if true;
      allow create: if settingUp();
    }

    // username / employee no. → sign-in address. Readable one at a time before sign-in.
    match /logins/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin() || settingUp();
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (settingUp() && uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /users/{id} {
      allow read: if isAdmin() || (isMember() && id == myProfile());
      allow create: if isAdmin() || settingUp();
      allow update: if isAdmin()
        // employees may only stamp their own sign-in time and password flag
        || (isMember() && id == myProfile()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'mustChangePassword', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin() || settingUp();
    }

    match /dispatches/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() || (isMember() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'open');
      allow update: if isAdmin()
        || (isMember() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'open'
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.code == resource.data.code);
      allow delete: if isAdmin();
    }

    // One doc per loaded box. Create-only, so the same box cannot land on two lists.
    match /boxkeys/{key} {
      allow read: if isMember();
      allow create: if isMember();
      allow update: if isAdmin();
      allow delete: if isMember();
    }

    match /counters/{day} {
      allow read, write: if isMember();
    }

    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isMember() && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
